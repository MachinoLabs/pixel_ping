{
  "account_id": "86ec0472e00b668215fbbea031f3e8bf",
  "main": "src/index.js",
  "workers_dev": true,
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "PIXELPING_KV",
      "id": "38f63eb3650649b28b683f47d02622b8"
    }
  ],
  "name": "fourth-rail-checkout",
  "compatibility_date": "2026-09-03",
  "vars": {
    "CLERK_ISSUER_URL": "https://clerk.pixelping.app",
    "EMAIL_NOTIFICATIONS_ENABLED": "true",
    "EMAIL_NOTIFICATIONS_START_AT": "1793283645",
    "EMAIL_FROM_ADDRESS": "PixelPing <notifications@updates.pixelping.app>"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "preview_urls": true
}
